# LabLock — environment template
#
# PUBLIC-BY-DESIGN values (safe to expose to the browser; NEXT_PUBLIC_ prefix).
# Supabase project URL (Mumbai, bom1).
NEXT_PUBLIC_SUPABASE_URL=
# Supabase anon key (public-by-design, RLS-protected).
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Sentry public DSN. Leave blank to disable event capture (Slice A behaviour).
NEXT_PUBLIC_SENTRY_DSN=

# ---------------------------------------------------------------------------
# SERVER-ONLY values. NEVER prefix these with NEXT_PUBLIC_. Anything with that
# prefix is inlined into the client bundle. Keep all of the following in
# Vercel environment variables (Production + Preview separated) and in the
# GitHub `production` environment, never in .env committed to git.
# ---------------------------------------------------------------------------
# Supabase service-role key (server-only). Bypasses RLS — never ship to a browser.
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection string (pooler or direct), used by server-side
# transactional booking code (lib/db.ts). Server-only.
SUPABASE_DB_URL=
# Sentry auth token for release/sourcemap upload in CI. Server-only.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
# PostHog project API key (analytics, Slice D). Server + client key.
NEXT_PUBLIC_POSTHOG_KEY=
# Pino log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info
# Pepper used to hash user references in audit_events.hashed_user_ref. Server-only.
AUDIT_PEPPER=change-me
